<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK TFM gives us Windows.Media.Ocr and the other WinRT APIs. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon) and GDI+ image scaling/encoding off the UI thread. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\WindowSearcher.ico</ApplicationIcon>
    <AssemblyName>WindowSearcher</AssemblyName>
    <!-- File description: the name Windows shows on the app's notifications and in Task Manager. -->
    <AssemblyTitle>Windows Window Search</AssemblyTitle>
    <RootNamespace>WindowSearcher.App</RootNamespace>
    <!-- DPI awareness is set in app.manifest for WPF; the WinForms-specific advice doesn't apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share many type names; keep WinForms types fully qualified. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowSearcher.Core\WindowSearcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- About screen images (display-sized copies of docs\logo.png and docs\OzAILabs.png). -->
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\branding.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- User guide (tray menu Help, F1 in the launcher, the help switch), installed as loose files next to the exe. -->
    <Content Include="Help\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- None, not Content: WPF looks for a Content file on disk instead of the embedded Resource, and the About images go blank. -->
    <None Update="Assets\logo.png" Link="Help\logo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Assets\branding.png" Link="Help\branding.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
