<Window x:Class="WindowSearcher.App.UI.AboutWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Windows Window Search"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White" Foreground="#1B1B1B"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <!-- Fixed light design: the logo and branding are made for a white background. -->
    <StackPanel Margin="36,28,36,24">
        <Image Source="/Assets/logo.png" Height="220" RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center" />

        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="#5E5E5E" />
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="440"
                   Text="Find any open window or browser tab by searching its title or the text inside it." />

        <Border Height="1" Background="#E3E3E3" Margin="0,22,0,18" />

        <TextBlock HorizontalAlignment="Center" FontSize="14">
            <Run Text="Created by " /><Run Text="OzAILabs" FontWeight="SemiBold" />
        </TextBlock>
        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0">
            <Hyperlink x:Name="ProfileLink" NavigateUri="https://github.com/OzAILabs" RequestNavigate="OnLinkClick"
                       Foreground="#005FB8">github.com/OzAILabs</Hyperlink>
        </TextBlock>

        <Image Source="/Assets/branding.png" Height="120" Margin="0,22,0,0" RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center" />

        <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12" Foreground="#5E5E5E" />

        <Button Content="Close" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="28,6" IsCancel="True" IsDefault="True"
                Click="OnCloseClick" />
    </StackPanel>
</Window>
