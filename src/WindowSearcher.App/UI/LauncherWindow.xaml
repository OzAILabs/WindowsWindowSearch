<Window x:Class="WindowSearcher.App.UI.LauncherWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WindowSearcher.App.UI"
        Title="Windows Window Search"
        Width="1180" Height="700" MinWidth="640" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <!-- Borderless, but resizable from every edge like a normal window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <TextBlock x:Name="Glyph" Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B22A1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileContainer" TargetType="ListBoxItem" BasedOn="{StaticResource ResultContainer}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Width" Value="264" />
        </Style>

        <Style x:Key="ClosedBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ClosedBadgeBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
        </Style>
        <Style x:Key="ClosedBadgeText" TargetType="TextBlock">
            <Setter Property="Text" Value="CLOSED" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ClosedBadgeTextBrush}" />
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource ClosedBadgeBrush}" VerticalAlignment="Top" Margin="2,3,0,0"
                           Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource ClosedBadge}" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource ClosedBadgeText}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <TextBlock ui:Highlight.Text="{Binding Snippet}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                               Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate">
            <StackPanel Margin="8">
                <Border Height="150" Background="{DynamicResource PanelBrush}" CornerRadius="4">
                    <Grid>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Image Source="{Binding Icon}" Width="32" Height="32" Opacity="0.5"
                               Visibility="{Binding ThumbPath, Converter={StaticResource NullToVisible}}" />
                        <Border Style="{StaticResource ClosedBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <TextBlock Style="{StaticResource ClosedBadgeText}" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               MaxWidth="218" />
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubTextBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the visible handle for moving the window. -->
        <Border x:Name="TitleBar" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Cursor="SizeAll"
                MouseLeftButtonDown="OnDragAreaMouseDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource TitleBarBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="16,0,10,0" />
                <TextBlock Grid.Column="1" Text="Windows Window Search" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ModeLabel" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0"
                           Foreground="{DynamicResource SubTextBrush}" FontSize="12" />
                <Button Grid.Column="3" Style="{StaticResource TitleCloseButton}" Click="OnCloseClick"
                        ToolTip="Close (Esc)" />
            </Grid>
        </Border>

        <!-- Search box -->
        <Border Grid.Row="1" Padding="18,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Margin="34,0,0,0" FontSize="20" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource TextBrush}"
                         CaretBrush="{DynamicResource TextBrush}" VerticalContentAlignment="Center"
                         TextChanged="OnSearchTextChanged" />
                <TextBlock x:Name="Placeholder" Margin="37,0,0,0" IsHitTestVisible="False" FontSize="20"
                           Text="Search windows, tabs and page text…" Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- List + preview -->
        <Grid x:Name="ListPanel" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ResultsList" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0,6"
                     ItemTemplate="{StaticResource ResultTemplate}"
                     ItemContainerStyle="{StaticResource ResultContainer}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnItemActivated"
                     Focusable="False" />
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ClosedBanner" Visibility="Collapsed" Background="{DynamicResource ClosedBannerBrush}"
                            BorderBrush="{DynamicResource ClosedBadgeBrush}" BorderThickness="1" CornerRadius="4"
                            Padding="12,8" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="This tab is closed." FontWeight="SemiBold" /><Run Text=" You're looking at a saved copy. Enter opens the address again, so the page may look different or ask you to sign in." />
                        </TextBlock>
                    </Border>
                    <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="PreviewEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image x:Name="PreviewIcon" Width="48" Height="48" Opacity="0.6" />
                        <TextBlock x:Name="PreviewEmptyText" Foreground="{DynamicResource SubTextBrush}" Margin="0,12,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="PreviewTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewUrl" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="PreviewSnippet" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                                   MaxHeight="60" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Thumbnail grid -->
        <ListBox x:Name="GridList" Grid.Row="2" Visibility="Collapsed" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                 Padding="10" ItemTemplate="{StaticResource TileTemplate}"
                 ItemContainerStyle="{StaticResource TileContainer}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseLeftButtonUp="OnItemActivated" Focusable="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Status bar; also moves the window. -->
        <Border Grid.Row="3" Padding="18,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"
                Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnDragAreaMouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource SubTextBrush}" FontSize="12" />
                    <Button x:Name="SeedButton" Margin="18,0,0,0" Visibility="Collapsed" Focusable="False" Cursor="Hand"
                            Click="OnSeedClick" ToolTip="Switch through Edge tabs that have no saved text or preview yet, then put everything back">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="Label" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="KeyHint" HorizontalAlignment="Right" Foreground="{DynamicResource SubTextBrush}" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
