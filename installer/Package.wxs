<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- UpgradeCode must never change: it is how new versions find and replace old ones. -->
  <Package Name="Windows Window Search"
           Manufacturer="OzAILabs"
           Version="$(var.ProductVersion)"
           UpgradeCode="BE82458D-0E6F-4054-B7C7-7E60CFEB4237"
           Scope="perMachine"
           Compressed="yes">

    <!-- Downgrades allowed so an older release can be installed straight over a newer one (rollback). -->
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs entry -->
    <Icon Id="AppIcon" SourceFile="$(var.AssetsDir)\WindowSearcher.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Search the text of open windows and browser tabs." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Windows Window Search" />
    </StandardDirectory>

    <!-- Everything from the self-contained publish folder. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="6B0E1C0B-8B8E-4B64-9D3C-3C4E2F1A7D21">
        <Shortcut Id="AppShortcut"
                  Name="Windows Window Search"
                  Description="Search open windows and browser tabs"
                  Target="[INSTALLFOLDER]WindowSearcher.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\Windows Window Search" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="HelpShortcut" Guid="3F7A2C51-9D4E-4B8A-A6C2-5E1D0B7F9C34">
        <Shortcut Id="HelpShortcut"
                  Name="Windows Window Search Help"
                  Description="User guide for Windows Window Search"
                  Target="[INSTALLFOLDER]Help\index.html" />
        <RegistryValue Root="HKLM" Key="Software\Windows Window Search" Name="HelpShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      The app runs in the tray: before InstallValidate checks for files in use (upgrade and uninstall),
      close it and wait until its files are really free (installer\close-app.ps1, embedded below as
      -EncodedCommand; a unit test keeps the two in sync). Right after the app exits, security software
      re-opens the exe for ~3 s. If InstallValidate runs then, and policy disables Restart Manager
      (DisableAutomaticApplicationShutdown), Windows Installer's fallback files-in-use check
      (msi!GetModuleUsage -> performance-data query of every process's memory map) takes 15+ minutes.
      util:CloseApplication can't help: it runs after InstallValidate. Immediate, so it runs as the
      signed-in user (SYSTEM under a management tool). Return is ignored: a failure only means no wait.
    -->
    <!-- Long arguments live in a property (no length limit); the action's own target must stay under 255 characters (ICE03). -->
    <Property Id="CloseAppArgs" Value="-NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand " />
    <CustomAction Id="SetCloseAppCmd" Property="WixQuietExecCmdLine"
                  Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; [CloseAppArgs]" />
    <CustomAction Id="CloseRunningApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SetCloseAppCmd" Before="CloseRunningApp" />
      <Custom Action="CloseRunningApp" Before="InstallValidate" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Windows Window Search" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="HelpShortcut" />
    </Feature>

    <!-- "Launch Windows Window Search" checkbox on the last page. Runs in the (non-elevated) UI process,
         so the app starts as the signed-in user, not as administrator. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Windows Window Search" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]WindowSearcher.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />

    <UIRef Id="WindowSearcherUI" />
  </Package>

  <!-- Like WixUI_Minimal, but a plain welcome page instead of a license-agreement page. -->
  <Fragment>
    <UI Id="WindowSearcherUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
